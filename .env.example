# Copy to .env (`make up` does it for you). These are values for a local machine only:
# change every password before exposing any port beyond localhost. .env is git-ignored.
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
# Rows ingested by the scheduled training run
DEMO_ROWS=5000
